  ],
  "principle": "Only a CG-15-attested remote branch may produce one exact pull-request creation request; a trusted external GitHub executor performs that single write, and CG-16 then re-reads and attests the resulting PR identity without granting merge authority.",
  "pullRequest": {
    "requiredSourceProtocol": "CG15-CONTROLLED-REMOTE-BRANCH-PUBLICATION",
    "requiredSourceStatus": "REMOTE_BRANCH_PUBLICATION_ATTESTED",
    "requiredSourceDecision": "CONTROLLED_REMOTE_BRANCH_PUBLICATION_VERIFIED",
    "provider": "GITHUB",
    "baseBranch": "main",
    "requestAuthority": "SINGLE_OPEN_PR_CREATE_REQUEST_ONLY",
    "externalExecutor": "TRUSTED_GITHUB_CONNECTOR",
    "requestBuilderSideEffectFree": true,
    "requireGitHubRepositorySlug": true,
    "requireSameRepository": true,
    "requireExactRemoteBase": true,
    "requireExactRemoteHead": true,
    "requireNonMainHead": true,
    "requireDistinctBaseHead": true,
    "requireNoExistingOpenMatch": true,
    "requireOpenState": true,
    "requireNonDraft": true,
    "requireMaintainerCanModifyFalse": true,
    "requireAutoMergeDisabled": true,
    "requireSingleCommit": true,
    "requireExactChangedPathSet": true,
    "pullRequestUpdateAuthorization": "NOT_GRANTED",
    "reviewSubmissionAuthorization": "NOT_GRANTED",
    "autoMergeAuthorization": "NOT_GRANTED",
    "mergeAuthorization": "NOT_GRANTED"
  },
  "authorityCeiling": {
    "buildsOnePullRequestCreateRequest": true,
    "executesProviderWriteInsideGovernanceCode": false,
    "externalTrustedExecutorRequired": true,
    "updatesExistingPullRequest": false,
    "submitsReview": false,
    "enablesAutoMerge": false,
    "mergesPullRequest": false,
    "modifiesRemoteBranch": false,
    "modifiesLocalCommit": false,
    "directMainUpdate": false,
    "repositoryAdministration": false,
    "consumerAdoption": false,
    "repositoryBlocking": false
  },
  "qualification": {
    "requireCurrentRealSubjectsRejectedWithoutCg15Attestation": true,
    "requireQualificationOnlyRealGithubPullRequest": true,
    "fixtureIsNotConsumerEvidence": true,
    "requireTrustedExternalExecutor": true,
    "requireQualificationPullRequestCleanup": true,
    "requireQualificationBranchCleanup": true,
    "requireExactPrIdentityReadback": true,
    "requireNegativeMatrix": true,
    "requireNoConsumerMutation": true,
    "requireExactCg15SourceBlobs": true,
    "discovery": {
      "head": "ce3770d3691720a275f5999f9becfae9b533a864",
      "run": 34661195304,
      "job": 103463875842,
      "result": "PROVIDER_WRITE_BLOCKED",
      "finding": "GitHub Actions GITHUB_TOKEN had contents:write and pull-requests:write but POST /pulls returned HTTP 403. The qualification branch cleanup succeeded. CG-16 therefore separates side-effect-free request construction from the trusted external GitHub executor instead of weakening repository settings or embedding a broader credential."
    }
  }
}
