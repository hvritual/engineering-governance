  "sourceProtocol": "CG19-CONTROLLED-MERGE-AUTHORIZATION",
  "requiredSourceStatus": "MERGE_AUTHORIZATION_ATTESTED",
  "requiredSourceDecision": "CONTROLLED_MERGE_AUTHORIZATION_VERIFIED",
  "principle": "Authorization is not execution. Only an exact, unconsumed CG-19 one-time authorization may produce one exact merge request. The trusted GitHub connector executes with expected_head_sha, and successful provider merged-state is the single-use consumption event.",
  "executionPolicy": {
    "provider": "GITHUB",
    "externalExecutor": "TRUSTED_GITHUB_CONNECTOR",
    "operation": "MERGE_PULL_REQUEST_ONCE",
    "allowedMergeMethods": ["squash"],
    "requiredGrant": "GRANTED_ONCE",
    "requiredUseLimit": 1,
    "requiredSourceConsumptionState": "NOT_CONSUMED",
    "requireSourceExecutesMergeFalse": true,
    "requireOpen": true,
    "requireNonDraft": true,
    "requireUnmerged": true,
    "requireMergeableTrue": true,
    "requireExactRepository": true,
    "requireExactPullRequestNumber": true,
    "requireExactBaseSha": true,
    "requireExactHeadSha": true,
    "requireExactChangedPaths": true,
    "requireExpectedHeadSha": true,
    "providerCompareAndSwap": "EXPECTED_HEAD_SHA",
    "providerSingleUseBoundary": "PR_OPEN_UNMERGED_TO_MERGED_TRANSITION",
    "postMergeRequireProviderMerged": true,
    "postMergeRequireBaseRefEqualsMergeSha": true,
    "postMergeRequireSingleParentEqualsAuthorizedBase": true,
    "postMergeRequireMergeTreeEqualsAuthorizedHeadTree": true,
    "successfulConsumptionState": "CONSUMED",
    "successfulConsumptionReason": "CONSUMED_BY_SUCCESSFUL_MERGE",
    "successfulUseCount": 1,
    "noSecondConsumptionSoT": true
  },
  "outputs": {
    "requestStatus": "MERGE_EXECUTION_REQUEST_READY",
    "requestDecision": "CONTROLLED_MERGE_EXECUTION_REQUEST_VERIFIED",
    "attestedStatus": "MERGE_EXECUTION_ATTESTED",
    "attestedDecision": "CONTROLLED_MERGE_EXECUTION_VERIFIED"
  },
  "authorityCeiling": {
    "executesOneAuthorizedProviderMerge": true,
    "consumesOneMergeAuthorization": true,
    "enablesAutoMerge": false,
    "updatesPullRequestMetadata": false,
    "submitsReview": false,
    "modifiesAuthorizedHead": false,
    "directMainUpdate": false,
    "repositoryAdministration": false,
    "consumerAdoption": false,
